{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "proto",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "proto/serve.py",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "site",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8766"
      ],
      "port": 8766
    },
    {
      "name": "server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js",
        "8777",
        "debug"
      ],
      "port": 8777
    }
  ]
}
